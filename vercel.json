{
  "headers": [
    {
      "source": "/playbook-vendas-vcn.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/playbook-vendas-vcn.html", "destination": "/playbook-vendas-vcn.html" },
    { "source": "/t/:id", "destination": "/api/og?task=:id" },
    { "source": "/share/tarefa/:id", "destination": "/api/og?task=:id" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
